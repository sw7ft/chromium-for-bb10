import("//build/config/chromeos/ui_mode.gni")
import("//build/config/clang/clang.gni")
import("//build/config/compiler/compiler.gni")
import("//build/config/compiler/pgo/pgo.gni")
import("//build/config/features.gni")
import("//build/toolchain/toolchain.gni")

# QNX PGI final link.
#
# HISTORY: this used to force ld.bfd (-fuse-ld=bfd + -B dirs +
# --no-gc-sections), which was one of the two documented PGO blockers: the
# 32-bit bfd exhausts its 4GB address space on the ~300MB instrumented
# binary. That forcing predates the discovery that the toolchain's default
# `ld` is already a 64-bit ld.lld-17 shim (see deploy/THINLTO.md) — the same
# linker that links every production build. The other blocker
# ("relocation refers to a symbol in a discarded section: .L__profd__*")
# was only ever observed through the staged-link script, whose `ld -r`
# partial links break COMDAT groups; a direct lld link does not need it.
# So: no ldflags — let the link fall through to the default lld shim.
config("pgo_qnx_bfd_link") {
  visibility = [
    ":default_pgo_flags",
    "//build/config:executable_deps",
  ]
}

# QNX links with GCC; the profile instrumentation runtime must be linked
# explicitly (see qnx_profile_runtime_path in pgo.gni).
config("pgo_qnx_profile_runtime") {
  visibility = [
    ":default_pgo_flags",
    "//build/config:executable_deps",
  ]

  if (chrome_pgo_phase == 1 && is_qnx && is_a_target_toolchain) {
    if (!defined(target_type) || target_type != "shared_library") {
      assert(qnx_profile_runtime_path != "",
             "Set qnx_profile_runtime_path to libclang_rt.profile-arm.a for PGI")
      libs = [ qnx_profile_runtime_path ]

      # Weak stub definitions for symbols the instrumented link cannot
      # resolve (see deploy/qnx-pgi-stubs.s, generated from the link error
      # log). Two classes:
      #  1. __profd_* of non-prevailing COMDAT copies: on runtime-registration
      #     platforms (QNX is not in LLVM's section-boundary OS list), each
      #     module's __llvm_profile_init registers profile data of inline
      #     functions whose prevailing copy lives elsewhere and whose data
      #     ThinLTO localized (.L) there. Weak zero-filled 40-byte stubs
      #     satisfy the ABS relocs; the runtime skips all-zero records and
      #     the real (prevailing) counters are registered by their own module.
      #  2. A few never-implemented test-only platform symbols referenced
      #     with ABS relocs from instrumentation-retained dead code.
      libs += [ "//deploy/qnx-pgi-stubs.o" ]

      # The BB10 port relies on ThinLTO dead-stripping to discard the large
      # amount of cross-platform code that has no QNX implementation (test
      # helpers, D3D translator paths, etc.). PGI instrumentation retains
      # those otherwise-dead functions, so their calls into never-implemented
      # platform symbols surface as ~35k "undefined symbol" errors at the exe
      # link. The production (non-instrumented) binary contains none of that
      # code, proving the paths never execute; letting them resolve to zero
      # in the profiling-only binary is safe. Executable link only.
      # --no-fatal-warnings must follow the default config's --fatal-warnings
      # or the tolerated unresolved-symbol warnings get re-promoted to errors.
      ldflags = [
        "-Wl,--warn-unresolved-symbols",
        "-Wl,--no-fatal-warnings",
      ]
    }
  }
}

# Counteracts default pgo_instrumentation_flags on targets that must not be
# instrumented (QNX shared libraries / loadable modules).
config("pgo_no_instrumentation") {
  visibility = [ "*" ]
  cflags = [ "-fno-profile-generate" ]

  # -fno-profile-generate only keeps a module's OWN sources clean; loadable
  # modules (web-test plugins) still link instrumented static libs from the
  # shared dep tree, whose __profd_* globals are default-visibility. Inside a
  # .so those are preemptible, and the LTO backend's R_ARM_REL32 references
  # to them are then illegal ("recompile with -fPIC" at SOLINK). -Bsymbolic
  # binds them locally, making the relocations resolvable at link time. These
  # test plugins are data_deps never loaded during profiling, so symbol
  # interposition semantics are irrelevant.
  ldflags = [ "-Wl,-Bsymbolic" ]
}

# Configuration that enables PGO instrumentation.
config("pgo_instrumentation_flags") {
  visibility = [ "*" ]

  # Only add flags when chrome_pgo_phase == 1, so that variables we would use
  # are not required to be defined when we're not actually using PGO.
  if (chrome_pgo_phase == 1 && is_clang && !is_nacl && is_a_target_toolchain &&
      (!defined(target_type) || target_type != "shared_library")) {
    cflags = [
      "-fprofile-generate",
    ]
    if (is_qnx) {
      # Value profiling references __profd_* globals from instrumented code.
      # Under ThinLTO cross-module importing, those references escape their
      # defining module and the PGI link fails with ~2200 undefined
      # __profd_<mangled>.<modhash> symbols (observed on gin_shell canary).
      # We only need block counters for PGO; drop value profiling at both
      # instrumentation (compile) and LTO-backend (link) stages.
      cflags += [
        "-mllvm",
        "-disable-vp",
      ]
      ldflags = [ "-Wl,-mllvm,-disable-vp" ]
    }
    if (!is_win) {
      # Windows directly calls link.exe instead of the compiler driver when
      # linking, and embeds the path to the profile runtime library as
      # dependent library into each object file.
      #
      # QNX uses GCC for the final link; -fprofile-generate there is ignored.
      # Use :pgo_qnx_profile_runtime instead.
      if (!is_qnx) {
        ldflags = [ "-fprofile-generate" ]
      }
    }
  }
}

# Configuration that enables optimization using profile data.
config("pgo_optimization_flags") {
  visibility = [ ":default_pgo_flags" ]

  # Only add flags when chrome_pgo_phase == 2, so that variables we would use
  # are not required to be defined when we're not actually using PGO.
  if (chrome_pgo_phase == 2 && is_clang && !is_nacl && is_a_target_toolchain) {
    _pgo_target = ""

    # There are txt files used by //tools/update_pgo_profiles.py to decide which
    # profiles to use, adding them as inputs so that analyzer recognizes the
    # dependencies.
    inputs = []

    if (is_win) {
      if (target_cpu == "arm64") {
        _pgo_target = "win-arm64"
      } else if (target_cpu == "x64") {
        _pgo_target = "win64"
      } else {
        _pgo_target = "win32"
      }
    } else if (is_mac) {
      if (target_cpu == "arm64") {
        _pgo_target = "mac-arm"
      } else {
        _pgo_target = "mac"
      }
    } else if (is_linux) {
      _pgo_target = "linux"
    } else if (is_chromeos_lacros) {
      if (target_cpu == "arm") {
        _pgo_target = "lacros-arm"
      } else if (target_cpu == "arm64") {
        _pgo_target = "lacros-arm64"
      } else {
        _pgo_target = "lacros64"
      }
    } else if (is_android) {
      # Use |current_cpu| and not |target_cpu|; for Android we may built both.
      if (current_cpu == "arm64") {
        _pgo_target = "android-arm64"
      } else {
        _pgo_target = "android-arm32"
      }
    } else if (is_fuchsia) {
      if (target_cpu == "arm64") {
        _pgo_target = "mac-arm"
      } else {
        _pgo_target = "mac"
      }
    } else if (is_ios && use_blink) {
      if (target_cpu == "arm64") {
        _pgo_target = "mac-arm"
      } else {
        _pgo_target = "mac"
      }
    } else if (is_qnx) {
      # Berry Browser: profiles are collected on-device and merged manually.
      # Always set pgo_data_path in args.gn; never fetch from GCS.
      _pgo_target = "qnx-arm"
    }

    if (_pgo_target == "win-arm64") {
      inputs = [ "//chrome/build/win-arm64.pgo.txt" ]
    } else if (_pgo_target == "win64") {
      inputs = [ "//chrome/build/win64.pgo.txt" ]
    } else if (_pgo_target == "win32") {
      inputs = [ "//chrome/build/win32.pgo.txt" ]
    } else if (_pgo_target == "mac-arm") {
      inputs = [ "//chrome/build/mac-arm.pgo.txt" ]
    } else if (_pgo_target == "mac") {
      inputs = [ "//chrome/build/mac.pgo.txt" ]
    } else if (_pgo_target == "linux") {
      inputs = [ "//chrome/build/linux.pgo.txt" ]
    } else if (_pgo_target == "lacros64") {
      inputs = [ "//chrome/build/lacros64.pgo.txt" ]
    } else if (_pgo_target == "lacros-arm") {
      inputs = [ "//chrome/build/lacros-arm.pgo.txt" ]
    } else if (_pgo_target == "lacros-arm64") {
      inputs = [ "//chrome/build/lacros-arm64.pgo.txt" ]
    } else if (_pgo_target == "android-arm32") {
      inputs = [ "//chrome/build/android-arm32.pgo.txt" ]
    } else if (_pgo_target == "android-arm64") {
      inputs = [ "//chrome/build/android-arm64.pgo.txt" ]
    }

    if (_pgo_target != "" && pgo_data_path == "" && !is_qnx) {
      pgo_data_path = exec_script("//tools/update_pgo_profiles.py",
                                  [
                                    "--target",
                                    _pgo_target,
                                    "get_profile_path",
                                  ],
                                  "value")
    }
    assert(pgo_data_path != "",
           "Please set pgo_data_path to point at the profile data")
    cflags = [
      "-fprofile-use=" + rebase_path(pgo_data_path, root_build_dir),

      # It's possible to have some profile data legitimately missing,
      # and at least some profile data always ends up being considered
      # out of date, so make sure we don't error for those cases.
      "-Wno-profile-instr-unprofiled",
      "-Wno-profile-instr-out-of-date",

      # Some hashing conflict results in a lot of warning like this when doing
      # a PGO build:
      #   warning: foo.cc: Function control flow change detected (hash mismatch)
      #   [-Wbackend-plugin]
      # See https://crbug.com/978401
      "-Wno-backend-plugin",
    ]

    # Enable basic block layout based on the extended TSP problem. This aims to
    # improve icache utilization and reduce the binary size.
    if (use_thin_lto) {
      if (is_win) {
        ldflags = [ "-mllvm:-enable-ext-tsp-block-placement=1" ]
      } else {
        ldflags = [ "-Wl,-mllvm,-enable-ext-tsp-block-placement=1" ]
      }
    } else {
      cflags += [
        "-mllvm",
        "-enable-ext-tsp-block-placement=1",
      ]
    }
  }
}

# Applies flags necessary when profile-guided optimization is used.
# Flags are only added if PGO is enabled, so that this config is safe to
# include by default.
config("default_pgo_flags") {
  if (chrome_pgo_phase == 0) {
    # Nothing. This config should be a no-op when chrome_pgo_phase == 0.
  } else if (chrome_pgo_phase == 1) {
    configs = [ ":pgo_instrumentation_flags" ]
    if (is_qnx) {
      configs += [ ":pgo_qnx_profile_runtime" ]
    }
  } else if (chrome_pgo_phase == 2) {
    configs = [ ":pgo_optimization_flags" ]
  }
}
