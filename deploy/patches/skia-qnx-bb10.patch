+// 32-bit ARM (AAPCS) only guarantees 8-byte stack alignment at public interfaces.
+// skvx::Vec loads/stores are already unaligned-safe (sk_unaligned_load / memcpy),
+// but alignas(16) on Vec<4,T> makes clang emit 16-byte-aligned NEON accesses
+// (e.g. `vld1.64 {d16-d17}, [rN :128]`) for stack locals. Function prologues
+// preserve 8-byte alignment, not 16, so those accesses fault with SIGBUS/BUS_ADRALN
+// on QNX/BB10 (observed in GrQuadUtils::TessellationHelper::inset on the GPU
+// thread). Cap the type alignment to 8 on 32-bit ARM only.
+#if defined(__arm__) && !defined(__aarch64__)
+    #define SKVX_ALIGN(bytes) ((bytes) > 8u ? 8u : (size_t)(bytes))
+#else
+    #define SKVX_ALIGN(bytes) (bytes)
+#endif
+
 namespace skvx {
 
 template <int N, typename T>
-struct alignas(N*sizeof(T)) Vec;
+struct alignas(SKVX_ALIGN(N*sizeof(T))) Vec;
 
