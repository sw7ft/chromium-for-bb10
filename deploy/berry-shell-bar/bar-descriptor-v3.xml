<?xml version="1.0" encoding="utf-8" standalone="no"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <!-- Distinct package id + name so V3 installs ALONGSIDE the existing
         BerryShell/BerryBrowser app instead of replacing it. -->
    <id>com.sw7ft.BerryShellV3</id>

    <name>BerryBrowserV3</name>
    <versionNumber>3.0.2</versionNumber>
    <buildId>43</buildId>
    <description>Chromium content_shell browser for BlackBerry 10 (QNX, on-screen via qnx_screen). V3: balanced defaults (GPU on, 720, 45fps, low-end mode), in-app Settings, restart, custom landing page.</description>
    <author>sw7ft</author>

    <!-- Native entry point: a tiny launcher that sets LD_LIBRARY_PATH / CA
         bundle and execs content_shell with the qnx_screen flags. -->
    <asset path="launcher" entry="true" type="Qnx/Elf">launcher</asset>

    <!-- Chromium binary + its runtime libraries (the rest come from the OS).
         Shipped as content_shell.exe because the launcher (launcher.c) execs
         "<dir>/content_shell.exe"; this makes the .bar self-contained so a clean
         install runs without the SSH hot-swap (deploy-binary.sh). -->
    <asset path="payload/content_shell" type="Qnx/Elf">content_shell.exe</asset>
    <asset path="payload/libstdc++.so.6" type="Qnx/Elf">libstdc++.so.6</asset>
    <asset path="payload/libgcc_s.so.1" type="Qnx/Elf">libgcc_s.so.1</asset>
    <asset path="payload/libm.so.2" type="Qnx/Elf">libm.so.2</asset>
    <!-- QSA (QNX Sound Architecture) client lib for microphone capture; not
         present in the BB10 base image, so bundle it. -->
    <asset path="payload/libasound.so.2" type="Qnx/Elf">libasound.so.2</asset>

    <!-- Chromium data/resource files (loaded relative to the working dir). -->
    <asset path="payload/content_shell.pak">content_shell.pak</asset>
    <asset path="payload/shell_resources.pak">shell_resources.pak</asset>
    <asset path="payload/ui_resources_100_percent.pak">ui_resources_100_percent.pak</asset>
    <asset path="payload/icudtl.dat">icudtl.dat</asset>
    <asset path="payload/snapshot_blob.bin">snapshot_blob.bin</asset>
    <asset path="payload/root_store.certs">root_store.certs</asset>

    <!-- Local start page (omnibox + bookmarks + Restart) loaded by default. -->
    <asset path="home.html">home.html</asset>

    <icon>
      <image>icon.png</image>
    </icon>
    <asset path="icons/icon.png">icon.png</asset>

    <initialWindow>
      <autoOrients>true</autoOrients>
      <systemChrome>none</systemChrome>
      <transparent>false</transparent>
    </initialWindow>

    <!-- Native code execution is required for content_shell. -->
    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission>access_shared</permission>
    <permission>run_when_backgrounded</permission>
    <!-- Microphone capture (getUserMedia audio). Without this, QNX io-audio
         denies snd_pcm capture and the real mic stays silent. -->
    <permission>record_audio</permission>

    <!-- Ensure bundled libs are found at run-time (launcher also sets this). -->
    <env var="LD_LIBRARY_PATH" value="app/native"/>
</qnx>
