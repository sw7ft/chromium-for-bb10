<?xml version="1.0" encoding="utf-8" standalone="no"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <!-- Distinct package id + name so the WhatsApp web app installs ALONGSIDE
         BerryBrowser / BerryBrowserV3 with its own sandbox (its own persistent
         content_shell_data, so the WhatsApp login is isolated and durable). -->
    <id>com.sw7ft.BerryWhatsApp</id>

    <name>WhatsApp</name>
    <versionNumber>1.0.0</versionNumber>
    <buildId>1</buildId>
    <description>WhatsApp Web as a standalone app for BlackBerry 10. Single-purpose Chromium content_shell tuned for web.whatsapp.com: desktop UA, Service Worker cache, persistent login, real microphone for voice messages, 720 render. Renders on-screen via qnx_screen.</description>
    <author>sw7ft</author>

    <!-- Native entry point: the WhatsApp launcher boots content_shell straight
         into web.whatsapp.com with the WhatsApp-tuned flag set. -->
    <asset path="whatsapp-launcher" entry="true" type="Qnx/Elf">launcher</asset>

    <!-- Chromium binary + runtime libraries. Reuses the exact same engine as
         BerryBrowserV3 (no WhatsApp-specific engine changes are needed: the
         desktop-UA-for-whatsapp.com flip and persistent profile are already
         built in). Shipped as content_shell.exe because the launcher execs
         "<dir>/content_shell.exe". -->
    <asset path="payload/content_shell" type="Qnx/Elf">content_shell.exe</asset>
    <asset path="payload/libstdc++.so.6" type="Qnx/Elf">libstdc++.so.6</asset>
    <asset path="payload/libgcc_s.so.1" type="Qnx/Elf">libgcc_s.so.1</asset>
    <asset path="payload/libm.so.2" type="Qnx/Elf">libm.so.2</asset>
    <!-- QSA (QNX Sound Architecture) client lib for microphone capture (voice
         messages); not present in the BB10 base image, so bundle it. -->
    <asset path="payload/libasound.so.2" type="Qnx/Elf">libasound.so.2</asset>

    <!-- Chromium data/resource files (loaded relative to the working dir). -->
    <asset path="payload/content_shell.pak">content_shell.pak</asset>
    <asset path="payload/shell_resources.pak">shell_resources.pak</asset>
    <asset path="payload/ui_resources_100_percent.pak">ui_resources_100_percent.pak</asset>
    <asset path="payload/icudtl.dat">icudtl.dat</asset>
    <asset path="payload/snapshot_blob.bin">snapshot_blob.bin</asset>
    <asset path="payload/root_store.certs">root_store.certs</asset>

    <icon>
      <image>icon.png</image>
    </icon>
    <asset path="icons/whatsapp.png">icon.png</asset>

    <initialWindow>
      <autoOrients>true</autoOrients>
      <systemChrome>none</systemChrome>
      <transparent>false</transparent>
    </initialWindow>

    <!-- Native code execution is required for content_shell. -->
    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission>access_shared</permission>
    <permission>run_when_backgrounded</permission>
    <!-- Microphone capture for WhatsApp voice messages (getUserMedia audio).
         Without this, QNX io-audio denies snd_pcm capture and the mic is silent. -->
    <permission>record_audio</permission>

    <!-- Ensure bundled libs are found at run-time (launcher also sets this). -->
    <env var="LD_LIBRARY_PATH" value="app/native"/>
</qnx>
